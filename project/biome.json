{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!!public", "!!drizzle"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noPrivateImports": "error"
      },
      "suspicious": {
        "noImportCycles": "error"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["components/**/*.ts", "components/**/*.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/features/**/actions/**",
                      "@/features/**/queries/**",
                      "@/features/**/services/**",
                      "@/features/**/repositories/**",
                      "@/features/**/gateways/**",
                      "@/controllers/**",
                      "@/server/**"
                    ],
                    "message": "Presentational components must receive data and callbacks through props."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["controllers/**/*.tsx", "controllers/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/features/**/queries/**",
                      "@/features/**/services/**",
                      "@/features/**/repositories/**",
                      "@/features/**/gateways/**",
                      "@/server/**"
                    ],
                    "message": "Client controllers may call actions but cannot import server infrastructure."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["features/**/actions/**/*.ts", "features/**/queries/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/features/**/repositories/**", "@/features/**/gateways/**", "@/server/**"],
                    "message": "Actions and queries must call services instead of repositories, gateways, or database infrastructure."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["features/**/services/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/server/**"],
                    "message": "Business services must use repositories instead of database infrastructure."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["app/**/page.tsx", "app/**/layout.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/features/**/actions/**",
                      "@/features/**/services/**",
                      "@/features/**/repositories/**",
                      "@/features/**/gateways/**",
                      "@/server/**"
                    ],
                    "message": "Pages must compose components and controllers and load data through feature queries."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["features/**/*.ts", "features/**/*.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/components/**", "@/controllers/**"],
                    "message": "Backend feature modules cannot depend on frontend components or controllers."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
