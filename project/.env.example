# Next.js Configuration
# Copy this file to .env.local and fill in your values
# Run: cp .env.example .env.local

# ============================================
# CLERK AUTHENTICATION (Task 2.1)
# ============================================
# Get your keys from https://clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here
CLERK_WEBHOOK_SIGNING_SECRET=whsec_your_signing_secret_here

# Existing Clerk development user used by authenticated Playwright tests.
# The same user must already be synchronized into the development Neon database.
E2E_CLERK_USER_EMAIL=e2e+clerk_test@your-domain.com

# Clerk URLs (update these after deploying)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ============================================
# WORKSPACE INVITATIONS (Step 8)
# ============================================
# Generate an API key at https://resend.com/api-keys and use a sender on a verified domain.
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=QuestBoard <invites@updates.your-domain.com>
# Optional monitored inbox for recipient replies.
RESEND_REPLY_TO_EMAIL=support@your-domain.com

# Protects the daily Vercel Cron endpoint that materializes deadline emails.
CRON_SECRET=replace_with_a_long_random_secret

# Public origin used to build invitation links. Do not include a trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# AI GENERATION AND SUBSCRIPTION BILLING
# ============================================
# Server-only Gemini credentials. Never prefix these with NEXT_PUBLIC_.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# PayMongo Checkout Sessions are created server-side. Keep test keys paired
# with test-mode catalog products and live keys with live-mode products.
PAYMONGO_SECRET_KEY=sk_test_your_key_here
PAYMONGO_WEBHOOK_SECRET=whsk_your_webhook_secret_here

# Configure the public webhook at:
# https://your-domain.example/api/webhooks/paymongo
# Enable only checkout_session.payment.paid for this one-time checkout flow.

# ============================================
# DATABASE (Task 3.2)
# ============================================
# Option 1: Vercel Postgres
# POSTGRES_URL=your_vercel_postgres_url
# POSTGRES_PRISMA_URL=your_vercel_postgres_prisma_url
# POSTGRES_URL_NON_POOLING=your_vercel_postgres_non_pooling_url

# Option 2: Neon Database
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Isolated Neon branch used only by database integration tests.
# It must resolve to a different hostname/database identity than DATABASE_URL.
TEST_DATABASE_URL=postgresql://test_user:test_password@test-branch-host/test_database?sslmode=require

# Required only when intentionally running db:reset:development.
# Use the secret-free identity printed as hostname:port/database (PostgreSQL defaults to port 5432).
DATABASE_ENVIRONMENT=development
DEVELOPMENT_RESET_DATABASE_IDENTITY=test-branch-host:5432/test_database

# Optional additional reset denylist. These values are never used to connect.
# PRODUCTION_DATABASE_URL=postgresql://user:password@production-host/database?sslmode=require
# PROTECTED_DATABASE_IDENTITIES=production-host:5432/database,staging-host:5432/database

# Option 3: Local PostgreSQL
# DATABASE_URL=postgresql://postgres:password@localhost:5432/projectflow

# ============================================
# OPTIONAL: DEVELOPMENT
# ============================================
# NODE_ENV=development

# ============================================
# NOTES FOR INTERNS
# ============================================
# - Never commit .env.local to git (it's in .gitignore)
# - Store sensitive keys securely
# - Use different keys for development and production
# - Get production keys from your team lead during deployment phase
# - Configure the Clerk webhook endpoint at /api/webhooks/clerk
# - Subscribe the Clerk webhook to user.created, user.updated, and user.deleted
